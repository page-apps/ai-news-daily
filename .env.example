# Public, non-secret GitHub repository identities used by the review screen.
# Values prefixed PUBLIC_ are compiled into the Pages client; never put a PAT here.
PUBLIC_NEWS_EDITORIAL_REPOSITORY=OWNER/ai-news-daily-editorial
PUBLIC_NEWS_PUBLIC_REPOSITORY=OWNER/ai-news-daily
PUBLIC_NEWS_REVIEWER_LOGIN=YOUR_GITHUB_LOGIN
PUBLIC_NEWS_EDITORIAL_BRANCH=main
PUBLIC_NEWS_PUBLIC_BRANCH=main
