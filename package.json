{
  "name": "ai-news-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "pnpm --filter @repo-apps/credentials build && pnpm --filter @repo-apps/repo-client build && pnpm --filter @repo-apps/ui build",
    "build": "astro check && astro build && node scripts/validate-build.mjs",
    "preview": "astro preview",
    "generate:daily": "bash scripts/generate-daily.sh",
    "publish:daily": "bash scripts/publish-daily.sh",
    "publish:draft": "bash scripts/publish-editorial-draft.sh",
    "auto:publish": "bash scripts/auto-publish-daily.sh",
    "sync:editorial-index": "bash scripts/sync-editorial-index.sh"
  },
  "dependencies": {
    "@repo-apps/credentials": "workspace:*",
    "@repo-apps/repo-client": "workspace:*",
    "@repo-apps/ui": "workspace:*",
    "@astrojs/mdx": "^4.3.0",
    "@vite-pwa/astro": "^1.1.0",
    "astro": "^5.14.0",
    "katex": "^0.16.22",
    "mermaid": "^11.10.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.2"
  }
}
