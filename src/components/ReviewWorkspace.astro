---
---

<section class="review-page" aria-labelledby="review-title">
  <div class="review-kicker"><p class="eyebrow">EDITORIAL CONTROL ROOM</p><span class="security-badge">Signed out · secure by default</span></div>
  <h1 id="review-title">Review the daily brief.</h1>
  <p class="review-lede">A private workspace for checking the next edition before it is published. Your session and draft stay out of the public build.</p>

  <section class="signed-out" aria-labelledby="signed-out-title">
    <h2 id="signed-out-title">Sign in to access review content</h2>
    <p>Authentication is required before drafts, source links, or publishing controls can be loaded. Nothing from a review session is included in this signed-out page.</p>
    <button class="review-action" type="button" data-sign-in>Sign in to review</button>
    <p class="field-hint" data-auth-message role="status" aria-live="polite"></p>
  </section>

  <section class="workspace" data-review-workspace hidden aria-labelledby="workspace-title">
    <div class="workspace-bar"><div><h2 id="workspace-title">Edition review</h2><p class="workspace-meta" data-edition-meta></p></div><span class="status-pill" data-edition-status>Draft</span></div>
    <div class="workspace-grid">
      <nav class="brief-nav" aria-label="Daily brief and stories"><h3>In this edition</h3><div data-story-nav></div></nav>
      <div class="editor">
        <div class="editor-header"><div><h3 data-story-heading>Story review</h3><p data-story-meta></p></div><span class="status-pill" data-story-status>Needs review</span></div>
        <form data-review-form>
          <div class="editor-fields">
            <div class="field"><label for="review-title-field">Title</label><input id="review-title-field" name="title" type="text" required /></div>
            <div class="field"><label for="review-summary-field">Summary</label><textarea id="review-summary-field" name="summary" required></textarea><p class="field-hint">Keep the reader’s first takeaway clear and specific.</p></div>
          </div>
          <div class="editor-section"><h3>Classification</h3><div class="editor-fields"><div class="field"><label for="review-categories-field">Categories</label><input id="review-categories-field" name="categories" type="text" aria-describedby="classification-hint" /><p id="classification-hint" class="field-hint">Separate categories with commas.</p></div><div class="field"><label for="review-tags-field">Tags</label><input id="review-tags-field" name="tags" type="text" /></div></div></div>
          <div class="editor-section"><h3>Source links</h3><div data-sources></div><div class="field source-editor"><label for="review-sources-field">Edit sources</label><textarea id="review-sources-field" name="sources" aria-describedby="sources-hint" placeholder="Source title | https://example.com"></textarea><p id="sources-hint" class="field-hint">One source per line. Use <code>Title | URL</code>, or a URL on its own.</p></div></div>
          <div class="review-state" data-review-state hidden><strong data-state-label>Review state</strong><p data-state-message></p><div class="diff" data-diff hidden></div></div>
          <div class="editor-footer"><span class="save-note" data-save-note>Changes are local until saved.</span><button class="publish-button" type="button" data-publish>Approve &amp; publish</button></div>
        </form>
      </div>
    </div>
  </section>
</section>

<dialog class="publish-dialog" data-publish-dialog aria-labelledby="publish-dialog-title">
  <h2 id="publish-dialog-title">Approve and publish?</h2><p data-dialog-message>Publishing marks the reviewed edition as stable and makes it available to readers.</p>
  <div class="dialog-actions"><button type="button" data-cancel-publish>Keep reviewing</button><button class="confirm" type="button" data-confirm-publish>Approve &amp; publish</button></div>
</dialog>

<script>
  // @ts-nocheck — this adapter intentionally accepts a client-owned draft model.
  const root = document.querySelector(".review-page");
  const workspace = root?.querySelector("[data-review-workspace]");
  const modelFromWindow = () => window.__AI_DAILY_REVIEW_MODEL__;
  const text = (value) => value == null ? "" : String(value);
  const list = (value) => Array.isArray(value) ? value : (text(value).split(",").map((item) => item.trim()).filter(Boolean));
  const render = (model) => {
    if (!model || !workspace) return;
    workspace.hidden = false;
    const edition = model.edition || model;
    const stories = edition.stories || model.stories || [];
    const items = [{ ...edition, reviewKind: "daily" }, ...stories.map((story) => ({ ...story, reviewKind: "story" }))];
    const meta = workspace.querySelector("[data-edition-meta]");
    if (meta) meta.textContent = [edition.date, edition.title].filter(Boolean).join(" · ");
    const editionStatus = workspace.querySelector("[data-edition-status]");
    if (editionStatus) editionStatus.textContent = text(edition.status || "Draft");
    const nav = workspace.querySelector("[data-story-nav]");
    if (!nav) return;
    nav.innerHTML = "";
    items.forEach((story, index) => {
      const button = document.createElement("button"); button.type = "button"; button.dataset.storyIndex = String(index); button.setAttribute("aria-current", index === 0 ? "true" : "false");
      const heading = document.createElement("strong"); heading.textContent = text(story.title || (index === 0 ? "Daily brief" : `Story ${index}`));
      const status = document.createElement("small"); status.textContent = text(story.status || "Needs review");
      button.append(heading, status); nav.append(button);
    });
    let current = Number.isInteger(model.selectedIndex) ? Math.min(Math.max(model.selectedIndex, 0), items.length - 1) : 0;
    const showStory = (index) => {
      current = index; const story = items[index] || edition; const form = workspace.querySelector("[data-review-form]");
      workspace.querySelector("[data-story-heading]").textContent = text(story.reviewKind === "daily" ? "Daily brief" : story.title || "Story review"); workspace.querySelector("[data-story-meta]").textContent = text(story.date || edition.date || ""); workspace.querySelector("[data-story-status]").textContent = text(story.status || "Needs review");
      form.elements.title.value = text(story.title); form.elements.summary.value = text(story.summary || story.description); form.elements.categories.value = list(story.categories).join(", "); form.elements.tags.value = list(story.tags).join(", ");
      const sources = workspace.querySelector("[data-sources]"); sources.replaceChildren(); (story.sources || []).forEach((source) => { const row = document.createElement("div"); row.className = "source-row"; const link = document.createElement("a"); link.href = text(source.resource || source.url); link.target = "_blank"; link.rel = "noopener noreferrer"; link.textContent = text(source.title || source.resource || source.url); const author = document.createElement("small"); author.textContent = text(source.author || "Source link"); row.append(link, author); sources.append(row); }); form.elements.sources.value = (story.sources || []).map((source) => source.title ? `${source.title} | ${source.resource || source.url}` : text(source.resource || source.url)).join("\n");
      nav.querySelectorAll("button").forEach((item) => item.setAttribute("aria-current", item.dataset.storyIndex === String(index) ? "true" : "false"));
      const state = story.conflict || story.diff ? "conflict" : story.status === "stable" ? "published" : "review"; const stateBox = workspace.querySelector("[data-review-state]"); const label = workspace.querySelector("[data-state-label]"); const message = workspace.querySelector("[data-state-message]"); const diff = workspace.querySelector("[data-diff]"); stateBox.hidden = false; label.textContent = state === "conflict" ? "Conflict detected" : state === "published" ? "Published" : "Review state"; message.textContent = state === "conflict" ? "The source changed while you were reviewing. Resolve the differences before publishing." : state === "published" ? "This story has been approved and is ready for the live edition." : "Check the wording and sources before approving this story."; if (story.diff) { diff.hidden = false; diff.textContent = text(story.diff); } else diff.hidden = true;
    };
    nav.addEventListener("click", (event) => { const button = event.target.closest("button[data-story-index]"); if (button) { showStory(Number(button.dataset.storyIndex)); window.dispatchEvent(new CustomEvent("ai-daily-review:select", { detail: { index: current } })); } });
    workspace.querySelector("[data-review-form]")?.addEventListener("input", (event) => {
      const form = event.currentTarget;
      const sourceLines = text(form.elements.sources.value).split("\n").map((line) => line.trim()).filter(Boolean).map((line) => { const split = line.lastIndexOf("|"); return split >= 0 ? { title: line.slice(0, split).trim(), resource: line.slice(split + 1).trim() } : { resource: line }; }).filter((source) => /^https?:\/\//.test(source.resource));
      window.dispatchEvent(new CustomEvent("ai-daily-review:edit", { detail: { index: current, title: form.elements.title.value, summary: form.elements.summary.value, categories: list(form.elements.categories.value), tags: list(form.elements.tags.value), sources: sourceLines } }));
    });
    showStory(current);
    workspace.querySelector("[data-publish]").addEventListener("click", () => document.querySelector("[data-publish-dialog]")?.showModal());
  };
  root?.querySelector("[data-sign-in]")?.addEventListener("click", () => { const message = root.querySelector("[data-auth-message]"); if (message) message.textContent = "Sign-in is provided by the authenticated review client."; window.dispatchEvent(new CustomEvent("ai-daily-review:sign-in")); });
  root?.querySelector("[data-cancel-publish]")?.addEventListener("click", () => document.querySelector("[data-publish-dialog]")?.close());
  root?.querySelector("[data-confirm-publish]")?.addEventListener("click", () => { document.querySelector("[data-publish-dialog]")?.close(); const note = root.querySelector("[data-save-note]"); if (note) note.textContent = "Approval sent to the review service."; window.dispatchEvent(new CustomEvent("ai-daily-review:publish")); });
  window.addEventListener("ai-daily-review:model", (event) => render(event.detail)); render(modelFromWindow());
</script>
