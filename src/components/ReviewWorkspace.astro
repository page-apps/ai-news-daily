---
import { STANDARD_SECURITY_DISCLOSURE } from "@repo-apps/ui";
---

<section class="review-page" aria-labelledby="review-title">
  <div class="review-kicker"><p class="eyebrow">EDITORIAL CONTROL ROOM</p><span class="security-badge">Signed out · secure by default</span></div>
  <h1 id="review-title">Review independent editions.</h1>
  <p class="review-lede">Each research pipeline creates its own daily article. Choose a pending draft to refine, publish it on its own, or retain it privately without publishing.</p>

  <section class="signed-out" aria-labelledby="signed-out-title">
    <h2 id="signed-out-title">Connect to the private draft</h2>
    <p data-connection-copy>The review client is checking this browser for your Page Apps credential.</p>
    <aside class="credential-disclosure" data-shared-disclosure hidden role="note">
      <strong>Use the shared Page Apps PAT?</strong>
      <p>{STANDARD_SECURITY_DISCLOSURE}</p>
      <p>AI Daily Brief independently verifies read/write access to both its public and private editorial repositories. Clicking <strong>Use shared PAT</strong> connects only this app; later visits may reconnect automatically.</p>
    </aside>
    <div class="connection-actions">
      <button class="review-action" type="button" data-sign-in disabled>Checking connection…</button>
      <button class="quiet-action" type="button" data-manual-sign-in hidden>Use a different PAT for this tab</button>
      <a class="quiet-link" href="https://page-apps.github.io/">Manage PAT in Page Apps hub</a>
    </div>
    <p class="field-hint" data-auth-message role="status" aria-live="polite"></p>
  </section>

  <section class="draft-queue" data-draft-queue hidden aria-labelledby="draft-queue-title">
    <div class="queue-heading"><div><p class="eyebrow">PENDING DRAFTS</p><h2 id="draft-queue-title">Choose an article to review.</h2></div><span data-draft-count></span></div>
    <div class="draft-list" data-draft-list></div>
    <p class="empty-state" data-empty-drafts hidden>No pending drafts. Published and discarded drafts stay in the private editorial repository.</p>
  </section>

  <section class="workspace" data-review-workspace hidden aria-labelledby="workspace-title">
    <div class="workspace-bar">
      <div><h2 id="workspace-title">Selected article</h2><p class="workspace-meta" data-edition-meta></p></div>
      <span class="status-pill" data-edition-status>Draft</span>
    </div>
    <p class="workspace-message" data-review-message role="status" aria-live="polite"></p>

    <form class="editor" data-review-form>
      <div class="editor-fields">
        <div class="field"><label for="review-title-field">Title</label><input id="review-title-field" name="title" type="text" required /></div>
        <div class="field"><label for="review-summary-field">Reader introduction</label><textarea id="review-summary-field" name="summary" required></textarea><p class="field-hint">This appears under the headline in the public edition.</p></div>
      </div>

      <section class="article-review" aria-labelledby="article-preview-title">
        <div class="section-heading"><div><p class="eyebrow">FULL ARTICLE</p><h3 id="article-preview-title">Reading preview</h3></div><span data-supporting-count></span></div>
        <article class="article-preview" data-article-preview></article>
        <details class="edit-drawer">
          <summary>Edit full article Markdown</summary>
          <div class="field"><label class="sr-only" for="review-body-field">Full article Markdown</label><textarea id="review-body-field" name="body" class="article-editor" required></textarea><p class="field-hint">The preview updates as you type. Mermaid and LaTex remain visible as source in this review screen and render on the published page.</p></div>
        </details>
      </section>

      <section class="editor-section" aria-labelledby="sources-title">
        <div class="section-heading"><div><p class="eyebrow">CITATIONS</p><h3 id="sources-title">Sources used by this edition</h3></div><span data-source-count></span></div>
        <div class="source-list-review" data-sources></div>
        <details class="edit-drawer">
          <summary>Edit source links</summary>
          <div class="field source-editor"><label for="review-sources-field">One source per line</label><textarea id="review-sources-field" name="sources" aria-describedby="sources-hint" placeholder="Source title | https://example.com"></textarea><p id="sources-hint" class="field-hint">Use <code>Title | URL</code>, or a URL on its own.</p></div>
        </details>
      </section>

      <details class="edit-drawer classification-drawer">
        <summary>Categories and connected-news tags</summary>
        <div class="editor-fields"><div class="field"><label for="review-categories-field">Categories</label><input id="review-categories-field" name="categories" type="text" /><p class="field-hint">Separate categories with commas.</p></div><div class="field"><label for="review-tags-field">Tags</label><input id="review-tags-field" name="tags" type="text" /></div></div>
      </details>

      <div class="editor-footer">
        <span class="save-note">Edits are saved to the private draft when you approve. Discarded drafts remain private and leave this queue.</span>
        <div class="editor-actions"><button class="quiet-action" type="button" data-discard>Discard private draft</button><button class="publish-button" type="button" data-publish>Approve article &amp; publish</button></div>
      </div>
    </form>
  </section>
</section>

<dialog class="publish-dialog" data-publish-dialog aria-labelledby="publish-dialog-title">
  <h2 id="publish-dialog-title">Approve this article?</h2>
  <p>Your edited article and its source list will become public. The ten supporting news concepts will be published automatically for tags and connected-news navigation.</p>
  <div class="dialog-actions"><button type="button" data-cancel-publish>Keep reviewing</button><button class="confirm" type="button" data-confirm-publish>Approve &amp; publish</button></div>
</dialog>

<dialog class="publish-dialog" data-discard-dialog aria-labelledby="discard-dialog-title">
  <h2 id="discard-dialog-title">Discard this private draft?</h2>
  <p>The article will remain in the private editorial repository, but it will no longer appear in this review queue and cannot be published from here unless restored manually.</p>
  <div class="dialog-actions"><button type="button" data-cancel-discard>Keep reviewing</button><button class="confirm" type="button" data-confirm-discard>Discard draft</button></div>
</dialog>

<script>
  // @ts-nocheck — this adapter accepts the private review model at runtime.
  const root = document.querySelector(".review-page");
  const workspace = root?.querySelector("[data-review-workspace]");
  const form = workspace?.querySelector("[data-review-form]");
  const dialog = document.querySelector("[data-publish-dialog]");
  const discardDialog = document.querySelector("[data-discard-dialog]");
  const draftQueue = root?.querySelector("[data-draft-queue]");
  const text = (value) => value == null ? "" : String(value);
  const list = (value) => Array.isArray(value) ? value : text(value).split(",").map((item) => item.trim()).filter(Boolean);

  const appendInline = (parent, value) => {
    const pattern = /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)|\*\*([^*]+)\*\*|`([^`]+)`|\*([^*]+)\*/g;
    let cursor = 0;
    for (const match of value.matchAll(pattern)) {
      parent.append(document.createTextNode(value.slice(cursor, match.index)));
      let node;
      if (match[1] && match[2]) { node = document.createElement("a"); node.textContent = match[1]; node.href = match[2]; node.target = "_blank"; node.rel = "noopener noreferrer"; }
      else if (match[3]) { node = document.createElement("strong"); node.textContent = match[3]; }
      else if (match[4]) { node = document.createElement("code"); node.textContent = match[4]; }
      else { node = document.createElement("em"); node.textContent = match[5]; }
      parent.append(node); cursor = match.index + match[0].length;
    }
    parent.append(document.createTextNode(value.slice(cursor)));
  };

  const renderMarkdown = (container, markdown) => {
    container.replaceChildren();
    const lines = text(markdown).split(/\r?\n/); let paragraph = []; let activeList; let fence;
    const flushParagraph = () => { if (!paragraph.length) return; const node = document.createElement("p"); appendInline(node, paragraph.join(" ")); container.append(node); paragraph = []; };
    const closeList = () => { activeList = undefined; };
    for (const line of lines) {
      if (fence) { if (/^```/.test(line)) { const pre = document.createElement("pre"); const code = document.createElement("code"); code.textContent = fence.lines.join("\n"); if (fence.language) code.dataset.language = fence.language; pre.append(code); container.append(pre); fence = undefined; } else fence.lines.push(line); continue; }
      const fenceStart = /^```([^\s]*)/.exec(line); if (fenceStart) { flushParagraph(); closeList(); fence = { language: fenceStart[1], lines: [] }; continue; }
      if (!line.trim()) { flushParagraph(); closeList(); continue; }
      const heading = /^(#{1,4})\s+(.+)$/.exec(line); if (heading) { flushParagraph(); closeList(); const level = Math.min(4, Math.max(2, heading[1].length + 1)); const node = document.createElement(`h${level}`); appendInline(node, heading[2]); container.append(node); continue; }
      const quote = /^>\s?(.*)$/.exec(line); if (quote) { flushParagraph(); closeList(); const node = document.createElement("blockquote"); appendInline(node, quote[1]); container.append(node); continue; }
      const unordered = /^[-*]\s+(.+)$/.exec(line); const ordered = /^\d+\.\s+(.+)$/.exec(line); const item = unordered ?? ordered;
      if (item) { flushParagraph(); const tag = unordered ? "ul" : "ol"; if (!activeList || activeList.tagName.toLowerCase() !== tag) { activeList = document.createElement(tag); container.append(activeList); } const node = document.createElement("li"); appendInline(node, item[1]); activeList.append(node); continue; }
      closeList(); paragraph.push(line.trim());
    }
    flushParagraph();
    if (fence) { const pre = document.createElement("pre"); const code = document.createElement("code"); code.textContent = fence.lines.join("\n"); pre.append(code); container.append(pre); }
  };

  const sourceValues = () => text(form?.elements.sources.value).split("\n").map((line) => line.trim()).filter(Boolean).map((line) => { const split = line.lastIndexOf("|"); return split >= 0 ? { title: line.slice(0, split).trim(), resource: line.slice(split + 1).trim() } : { resource: line }; }).filter((source) => /^https?:\/\//.test(source.resource));
  const sourceHost = (value) => { try { return new URL(value).hostname; } catch { return "Source link"; } };
  const emitEdit = () => {
    if (!form) return;
    renderMarkdown(workspace.querySelector("[data-article-preview]"), form.elements.body.value);
    window.dispatchEvent(new CustomEvent("ai-daily-review:edit", { detail: { title: form.elements.title.value, summary: form.elements.summary.value, body: form.elements.body.value, categories: list(form.elements.categories.value), tags: list(form.elements.tags.value), sources: sourceValues() } }));
  };

  const renderQueue = (model) => {
    if (!draftQueue) return;
    draftQueue.hidden = false;
    const drafts = Array.isArray(model?.drafts) ? model.drafts : [];
    const count = draftQueue.querySelector("[data-draft-count]"); if (count) count.textContent = `${drafts.length} pending`;
    const listContainer = draftQueue.querySelector("[data-draft-list]"); const empty = draftQueue.querySelector("[data-empty-drafts]");
    listContainer?.replaceChildren(); if (empty) empty.hidden = drafts.length > 0;
    drafts.forEach((draft) => {
      const button = document.createElement("button"); button.type = "button"; button.className = "draft-card"; button.dataset.draftId = draft.id; button.setAttribute("aria-pressed", String(draft.id === model.selectedDraftId));
      const date = document.createElement("time"); date.textContent = text(draft.date);
      const copy = document.createElement("span"); const title = document.createElement("strong"); title.textContent = text(draft.pipeline?.title || "Untitled pipeline"); const categories = document.createElement("small"); categories.textContent = list(draft.pipeline?.categories).join(" · "); copy.append(title, categories);
      const arrow = document.createElement("i"); arrow.textContent = "→"; button.append(date, copy, arrow); listContainer?.append(button);
    });
  };

  const render = (model) => {
    renderQueue(model);
    if (!workspace || !form) return;
    if (!model?.edition) { workspace.hidden = true; return; }
    const edition = model.edition;
    workspace.hidden = false;
    const meta = workspace.querySelector("[data-edition-meta]"); if (meta) meta.textContent = [edition.date, edition.title].filter(Boolean).join(" · ");
    const status = workspace.querySelector("[data-edition-status]"); if (status) status.textContent = text(edition.status || "Draft");
    form.elements.title.value = text(edition.title); form.elements.summary.value = text(edition.summary || edition.description); form.elements.body.value = text(edition.body); form.elements.categories.value = list(edition.categories).join(", "); form.elements.tags.value = list(edition.tags).join(", ");
    const sources = Array.from(new Map((edition.sources || []).filter((source) => source.resource).map((source) => [source.resource, source])).values());
    form.elements.sources.value = sources.map((source) => source.title ? `${source.title} | ${source.resource}` : text(source.resource)).join("\n");
    const sourceContainer = workspace.querySelector("[data-sources]"); sourceContainer.replaceChildren(); sources.forEach((source, index) => { const row = document.createElement("div"); row.className = "source-row"; const number = document.createElement("b"); number.textContent = String(index + 1).padStart(2, "0"); const link = document.createElement("a"); link.href = source.resource; link.target = "_blank"; link.rel = "noopener noreferrer"; link.textContent = text(source.title || source.resource); const author = document.createElement("small"); author.textContent = text(source.author || sourceHost(source.resource)); row.append(number, link, author); sourceContainer.append(row); });
    const sourceCount = workspace.querySelector("[data-source-count]"); if (sourceCount) sourceCount.textContent = `${sources.length} source${sources.length === 1 ? "" : "s"}`;
    const supporting = workspace.querySelector("[data-supporting-count]"); if (supporting) supporting.textContent = `${edition.supportingConcepts || 0} supporting concepts · no separate review`;
    renderMarkdown(workspace.querySelector("[data-article-preview]"), edition.body);
  };

  form?.addEventListener("input", emitEdit);
  root?.querySelector("[data-sign-in]")?.addEventListener("click", () => window.dispatchEvent(new CustomEvent("ai-daily-review:sign-in")));
  root?.querySelector("[data-manual-sign-in]")?.addEventListener("click", () => window.dispatchEvent(new CustomEvent("ai-daily-review:manual-sign-in")));
  root?.querySelector("[data-publish]")?.addEventListener("click", () => {
    if (form && !form.reportValidity()) return;
    if (typeof dialog?.showModal === "function") dialog.showModal();
    else if (window.confirm("Approve this daily article and publish it now?")) window.dispatchEvent(new CustomEvent("ai-daily-review:publish"));
  });
  document.querySelector("[data-cancel-publish]")?.addEventListener("click", () => dialog?.close());
  document.querySelector("[data-confirm-publish]")?.addEventListener("click", () => { dialog?.close(); window.dispatchEvent(new CustomEvent("ai-daily-review:publish")); });
  root?.querySelector("[data-discard]")?.addEventListener("click", () => {
    if (typeof discardDialog?.showModal === "function") discardDialog.showModal();
    else if (window.confirm("Discard this private draft? It will remain in the editorial repository.")) window.dispatchEvent(new CustomEvent("ai-daily-review:discard"));
  });
  document.querySelector("[data-cancel-discard]")?.addEventListener("click", () => discardDialog?.close());
  document.querySelector("[data-confirm-discard]")?.addEventListener("click", () => { discardDialog?.close(); window.dispatchEvent(new CustomEvent("ai-daily-review:discard")); });
  draftQueue?.addEventListener("click", (event) => {
    const button = event.target?.closest?.("[data-draft-id]");
    if (button?.dataset?.draftId) window.dispatchEvent(new CustomEvent("ai-daily-review:select-draft", { detail: { id: button.dataset.draftId } }));
  });

  window.addEventListener("ai-daily-review:model", (event) => render(event.detail));
  window.addEventListener("ai-daily-review:connection", (event) => {
    const mode = event.detail?.mode; const primary = root?.querySelector("[data-sign-in]"); const manual = root?.querySelector("[data-manual-sign-in]"); const disclosure = root?.querySelector("[data-shared-disclosure]"); const copy = root?.querySelector("[data-connection-copy]");
    if (!primary) return;
    primary.disabled = mode === "checking"; primary.textContent = mode === "checking" ? "Checking connection…" : mode === "shared" ? "Use shared PAT" : "Connect for this tab";
    if (manual) manual.hidden = mode !== "shared"; if (disclosure) disclosure.hidden = mode !== "shared"; if (copy) copy.textContent = mode === "shared" ? "A PAT from the Page Apps hub is ready on this browser." : mode === "manual" ? "No Page Apps PAT is available on this browser yet." : "Checking this browser for your Page Apps credential.";
  });
  window.addEventListener("ai-daily-review:status", (event) => {
    const detail = event.detail || {}; const publish = root?.querySelector("[data-publish]"); const discard = root?.querySelector("[data-discard]"); const confirm = document.querySelector("[data-confirm-publish]"); const discardConfirm = document.querySelector("[data-confirm-discard]"); const primary = root?.querySelector("[data-sign-in]");
    if (publish) { publish.disabled = Boolean(detail.busy); publish.textContent = detail.busy ? "Working…" : "Approve article & publish"; }
    if (discard) discard.disabled = Boolean(detail.busy); if (confirm) confirm.disabled = Boolean(detail.busy); if (discardConfirm) discardConfirm.disabled = Boolean(detail.busy); if (primary) primary.disabled = Boolean(detail.busy);
    root?.querySelectorAll("[data-review-message], [data-auth-message]").forEach((target) => { target.textContent = text(detail.message); target.dataset.tone = detail.error ? "error" : detail.success ? "success" : "neutral"; });
  });
</script>
