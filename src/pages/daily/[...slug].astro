---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toSlug, trustTier } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const editions = await getCollection("daily", ({ data }) => data.status === "stable");
  return editions.map((edition) => ({ params: { slug: edition.id }, props: { edition } }));
}
const { edition } = Astro.props;
const { Content } = await render(edition);
const date = edition.data.date.toLocaleDateString("en-AU", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
const storyMap = new Map((await getCollection("news", ({ data }) => data.status === "stable")).map((story) => [story.id, story]));
const stories = edition.data.news.map((id) => storyMap.get(id)).filter(Boolean);
---

<BaseLayout title={`${edition.data.title} · AI Daily Brief`} description={edition.data.description}>
  <article class="edition">
    <a class="back-link" href={import.meta.env.BASE_URL}>← All editions</a>
    <header class="edition-header">
      <p class="eyebrow">{date} · {edition.data.readingMinutes} MIN READ</p>
      <h1>{edition.data.title}</h1>
      <p class="dek">{edition.data.description}</p>
      <div class="topic-row">
        {edition.data.categories.map((category) => <a href={`${import.meta.env.BASE_URL}topics/category/${toSlug(category)}/`}>{category}</a>)}
        {edition.data.tags.map((tag) => <a href={`${import.meta.env.BASE_URL}topics/tag/${toSlug(tag)}/`}>#{tag}</a>)}
      </div>
      <p class="knowledge-meta">{edition.data.type} · {trustTier(edition.data.verified)} · generated {edition.data.generated?.at.toLocaleDateString("en-AU") ?? "without generation metadata"}</p>
    </header>
    {stories.length > 0 && <section class="story-index" aria-labelledby="stories-title">
      <p class="eyebrow" id="stories-title">THE CONNECTED STORIES</p>
      {stories.map((story, index) => story && <a href={`${import.meta.env.BASE_URL}news/${story.id}/`}><b>{String(index + 1).padStart(2, "0")}</b><span><strong>{story.data.title}</strong><small>{story.data.summary}</small></span><i>→</i></a>)}
    </section>}
    <div class="article-body"><Content /></div>
  </article>
</BaseLayout>
