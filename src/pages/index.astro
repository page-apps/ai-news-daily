---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toSlug } from "../lib/taxonomy";
import { withBase } from "../lib/base-url";

const editions = (await getCollection("daily", ({ data }) => data.status === "stable"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const editionsByDate = new Map<string, typeof editions>();
for (const edition of editions) {
  const dateKey = edition.data.date.toISOString().slice(0, 10);
  editionsByDate.set(dateKey, [...(editionsByDate.get(dateKey) ?? []), edition]);
}
const editionDays = [...editionsByDate.values()];
const latestDay = editionDays[0] ?? [];
const latestDate = latestDay[0]?.data.date;
const earlierEditions = editionDays.slice(1).flat();
const formatDate = (date: Date) => date.toLocaleDateString("en-AU", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout description="A focused daily briefing on the news shaping AI.">
  <section class="hero">
    <p class="eyebrow">THE DAILY SIGNAL</p>
    <h1>AI news, distilled.<br /><em>Insight, not noise.</em></h1>
    <p class="hero-copy">Ten important developments, carefully researched and connected into one readable daily edition.</p>
  </section>
  {latestDate ? (
    <section class="latest">
      <p class="eyebrow">{latestDay.length === 1 ? "LATEST EDITION" : "LATEST EDITIONS"} · {formatDate(latestDate)}</p>
      {latestDay.map((edition, index) => <article class="latest-edition">
        <a class="feature-card" href={withBase(`daily/${edition.id}/`)}>
          <span class="feature-number">{String(index + 1).padStart(2, "0")}</span>
          <div><h2>{edition.data.title}</h2><p>{edition.data.description}</p><span class="read-link">Read the edition <b>→</b></span></div>
          <span class="reading-time">{edition.data.readingMinutes} min</span>
        </a>
        {edition.data.categories.length > 0 && <div class="topic-row">{edition.data.categories.map((category) => <a href={withBase(`topics/category/${toSlug(category)}/`)}>{category}</a>)}</div>}
      </article>)}
    </section>
  ) : <p class="empty-state">The first edition is being prepared.</p>}
  {earlierEditions.length > 0 && <section class="archive"><p class="eyebrow">EARLIER EDITIONS</p>{earlierEditions.map((edition) => <a href={withBase(`daily/${edition.id}/`)}><time>{formatDate(edition.data.date)}</time><span>{edition.data.title}</span><small>{edition.data.readingMinutes} min →</small></a>)}</section>}
</BaseLayout>
