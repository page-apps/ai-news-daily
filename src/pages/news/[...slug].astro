---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toSlug, trustTier } from "../../lib/taxonomy";
import { baseUrl, withBase } from "../../lib/base-url";

export async function getStaticPaths() {
  const stories = await getCollection("news", ({ data }) => data.status === "stable");
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}
const { story } = Astro.props;
const { Content } = await render(story);
const allStories = await getCollection("news", ({ data }) => data.status === "stable");
const related = allStories
  .filter((candidate) => candidate.id !== story.id)
  .map((candidate) => ({ candidate, score: candidate.data.tags.filter((tag) => story.data.tags.includes(tag)).length * 3 + candidate.data.categories.filter((category) => story.data.categories.includes(category)).length }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.candidate.data.date.getTime() - a.candidate.data.date.getTime())
  .slice(0, 4);
const editions = (await getCollection("daily", ({ data }) => data.status === "stable"))
  .filter((edition) => edition.data.news.includes(story.id));
const date = story.data.date.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={`${story.data.title} · AI Daily Brief`} description={story.data.description}>
  <article class="edition story">
    <a class="back-link" href={baseUrl}>← All editions</a>
    <header class="edition-header">
      <p class="eyebrow">NEWS CONCEPT · {date}</p>
      <h1>{story.data.title}</h1>
      <p class="dek">{story.data.description}</p>
      <div class="topic-row">
        {story.data.categories.map((category) => <a href={withBase(`topics/category/${toSlug(category)}/`)}>{category}</a>)}
        {story.data.tags.map((tag) => <a href={withBase(`topics/tag/${toSlug(tag)}/`)}>#{tag}</a>)}
      </div>
      <p class="knowledge-meta">{trustTier(story.data.verified)} · generated by {story.data.generated?.by ?? "unknown"}</p>
    </header>
    <div class="article-body"><Content /></div>
    {story.data.sources.length > 0 && <section class="source-list"><p class="eyebrow">PROVENANCE</p>{story.data.sources.map((source) => <a href={source.resource} rel="noreferrer"><span>{source.title ?? source.resource}</span><small>{source.author ?? "Source"} · ↗</small></a>)}</section>}
    {related.length > 0 && <section class="connection-list"><p class="eyebrow">CONNECTED NEWS</p>{related.map(({ candidate }) => <a href={withBase(`news/${candidate.id}/`)}><span>{candidate.data.title}</span><small>{candidate.data.tags.filter((tag) => story.data.tags.includes(tag)).map((tag) => `#${tag}`).join(" ")} →</small></a>)}</section>}
    {editions.length > 0 && <p class="appears-in">Appears in {editions.map((edition) => <a href={withBase(`daily/${edition.id}/`)}>{edition.data.title}</a>)}</p>}
  </article>
</BaseLayout>
