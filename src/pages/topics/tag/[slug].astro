---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { toSlug } from "../../../lib/taxonomy";

export async function getStaticPaths() {
  const stories = await getCollection("news", ({ data }) => data.status === "stable");
  const tags = [...new Set(stories.flatMap((story) => story.data.tags))];
  return tags.map((tag) => ({ params: { slug: toSlug(tag) }, props: { tag } }));
}
const { tag } = Astro.props;
const stories = (await getCollection("news", ({ data }) => data.status === "stable" && data.tags.includes(tag))).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`#${tag} · AI Daily Brief`} description={`AI news connected by the ${tag} tag.`}>
  <section class="taxonomy listing"><a class="back-link" href={`${import.meta.env.BASE_URL}topics/`}>← Explore</a><p class="eyebrow">TAG</p><h1>#{tag}</h1><p>Stories connected through a shared idea, actor, technology or theme.</p><div class="story-list">{stories.map((story) => <a href={`${import.meta.env.BASE_URL}news/${story.id}/`}><time>{story.data.date.toLocaleDateString("en-AU", { day: "numeric", month: "short" })}</time><span><strong>{story.data.title}</strong><small>{story.data.summary}</small></span><i>→</i></a>)}</div></section>
</BaseLayout>
